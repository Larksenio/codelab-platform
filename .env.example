# Backend
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=codelab;User=codelab;Password=codelab_pass;
Jwt__Key=CHANGE_ME_MINIMUM_32_CHARACTER_SECRET_KEY
